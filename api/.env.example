# Vectra Health LLM Agent
#
# NVIDIA hosted NIM / API Catalog (OpenAI-compatible)
VECTRA_LLM_PROVIDER=nvidia
VECTRA_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
VECTRA_LLM_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_API_KEY=coloque_sua_chave_aqui

# Alternative generic variable read by the backend:
# VECTRA_LLM_API_KEY=coloque_sua_chave_aqui

# OpenAI fallback, if you decide to use it instead:
# VECTRA_LLM_PROVIDER=openai
# VECTRA_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=coloque_sua_chave_aqui

# ============================================================
# Google Earth Engine — Visão Computacional por satélite (NDVI/NDWI/LST)
# ============================================================
# 1. Crie conta gratuita: https://earthengine.google.com
# 2. Crie uma Service Account no Google Cloud e gere a chave JSON
# 3. Preencha abaixo com o e-mail da conta de serviço e o caminho da chave
# 4. pip install earthengine-api
#
# Lido por: src/data/fetch_satellite_cv.py
VECTRA_GEE_SERVICE_ACCOUNT=sua-conta@projeto.iam.gserviceaccount.com
VECTRA_GEE_KEY_FILE=C:\caminho\para\sua-chave-gee.json
